---
import AppLayout from "../../../layouts/AppLayout.astro";
import { supabase } from "../../../lib/supabase";
import PageHeader from "@/components/page-header.astro";
import { buttonVariants } from "@/components/ui/button";
import { Package, Plus, Search, AlertTriangle, TrendingDown, ShieldCheck, ChevronRight } from "lucide-react";
export const prerender = false;

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

await supabase.auth.setSession({
    refresh_token: refreshToken!.value,
    access_token: accessToken!.value,
});

const {
    data: { user },
} = await supabase.auth.getUser();
const metadata = user?.user_metadata;

const { data: empresas } = await supabase
    .from("empresas")
    .select("nombre, slug");

const currentEmpresa = empresas?.find((e) => e.slug === Astro.params.slug);
---

<AppLayout
    title={`Inventario - ${currentEmpresa?.nombre}`}
    slug={currentEmpresa?.slug ?? ""}
    companyName={currentEmpresa?.nombre ?? ""}
    currentPage="Inventario"
    empresas={empresas ?? []}
    userName={`${metadata?.first_name ?? ""} ${metadata?.last_name ?? ""}`.trim() || user?.email?.split("@")[0] || "Usuario"}
    userEmail={user?.email ?? ""}
>
    <div class="space-y-6 w-full py-2">
        {/* Cabecera Premium Reutilizable */}
        <PageHeader 
            title="Inventario" 
            description={`Supervisa, edita y gestiona las existencias físicas de mercancía y productos de ${currentEmpresa?.nombre}.`}
        >
            <Package slot="icon" className="size-5" />
            
            <a 
                href="#" 
                class={`${buttonVariants()} shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 group font-semibold`}
                slot="actions"
            >
                <Plus className="size-4 transition-transform duration-300 group-hover:rotate-90" />
                Agregar producto
            </a>
        </PageHeader>

        {/* Tarjetas de Métricas de Inventario */}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs flex flex-col justify-between hover:shadow-md transition-all duration-300 group">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-muted-foreground">Productos Registrados</span>
                    <div class="p-2 bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-lg border border-blue-500/20">
                        <ShieldCheck className="size-4" />
                    </div>
                </div>
                <div class="mt-4 space-y-1">
                    <h3 class="text-3xl font-extrabold tracking-tight text-foreground">348 productos</h3>
                    <p class="text-xs text-muted-foreground">Todos con SKU y códigos de barra válidos</p>
                </div>
            </div>

            <div class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs flex flex-col justify-between hover:shadow-md transition-all duration-300 group">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-muted-foreground">Artículos con Bajo Stock</span>
                    <div class="p-2 bg-amber-500/10 text-amber-600 dark:text-amber-400 rounded-lg border border-amber-500/20">
                        <AlertTriangle className="size-4" />
                    </div>
                </div>
                <div class="mt-4 space-y-1">
                    <h3 class="text-3xl font-extrabold tracking-tight text-foreground">12 artículos</h3>
                    <p class="text-xs text-amber-500 font-semibold flex items-center gap-1">
                        Requieren reabastecimiento pronto
                    </p>
                </div>
            </div>

            <div class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs flex flex-col justify-between hover:shadow-md transition-all duration-300 group">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-muted-foreground">Agotados</span>
                    <div class="p-2 bg-red-500/10 text-red-600 dark:text-red-400 rounded-lg border border-red-500/20">
                        <TrendingDown className="size-4" />
                    </div>
                </div>
                <div class="mt-4 space-y-1">
                    <h3 class="text-3xl font-extrabold tracking-tight text-foreground">2 artículos</h3>
                    <p class="text-xs text-red-500 font-semibold">Generando pérdida de venta activa</p>
                </div>
            </div>
        </div>

        {/* Buscador y Tabla */}
        <div class="space-y-4">
            <div class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-1">
                    <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-muted-foreground" />
                    <input 
                        type="text" 
                        placeholder="Buscar por nombre, SKU o categoría de producto..." 
                        class="w-full pl-10 pr-4 py-2 border border-border bg-card/35 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-muted-foreground"
                    />
                </div>
                <div class="flex items-center gap-2">
                    <select class="px-4 py-2 border border-border bg-card/35 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                        <option>Todas las Categorías</option>
                        <option>Materia Prima</option>
                        <option>Producto Terminado</option>
                        <option>Empaquetado</option>
                    </select>
                </div>
            </div>

            <div class="border border-border/85 rounded-2xl bg-card/30 backdrop-blur-md overflow-hidden shadow-xs">
                <div class="p-5 border-b border-border/80 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-foreground">Catálogo de Artículos</h3>
                        <p class="text-xs text-muted-foreground">Control físico de existencias y valor comercial</p>
                    </div>
                    <button class="text-xs font-semibold text-primary hover:text-primary/80 transition-colors flex items-center gap-1">
                        Exportar a Excel <ChevronRight className="size-3" />
                    </button>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left border-collapse">
                        <thead>
                            <tr class="bg-muted/40 text-muted-foreground font-semibold text-xs border-b border-border/50">
                                <th class="p-4 pl-6">Código / SKU</th>
                                <th class="p-4">Nombre del Producto</th>
                                <th class="p-4">Categoría</th>
                                <th class="p-4">Stock</th>
                                <th class="p-4">Precio Venta</th>
                                <th class="p-4 pr-6 text-right">Estatus Stock</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border/40">
                            <tr class="hover:bg-muted/20 transition-colors">
                                <td class="p-4 pl-6 font-mono text-xs text-muted-foreground">SKU-20492-MP</td>
                                <td class="p-4 font-semibold text-foreground">Madera de Pino Premium (1x4)</td>
                                <td class="p-4">Materia Prima</td>
                                <td class="p-4 font-bold text-foreground">1,250 pzas</td>
                                <td class="p-4 font-bold text-foreground">$12.50</td>
                                <td class="p-4 pr-6 text-right">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/10">
                                        Óptimo
                                    </span>
                                </td>
                            </tr>
                            <tr class="hover:bg-muted/20 transition-colors">
                                <td class="p-4 pl-6 font-mono text-xs text-muted-foreground">SKU-30948-PT</td>
                                <td class="p-4 font-semibold text-foreground">Silla Comedor Escandinava</td>
                                <td class="p-4">Producto Terminado</td>
                                <td class="p-4 font-bold text-foreground">8 pzas</td>
                                <td class="p-4 font-bold text-foreground">$180.00</td>
                                <td class="p-4 pr-6 text-right">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/10">
                                        Bajo Stock
                                    </span>
                                </td>
                            </tr>
                            <tr class="hover:bg-muted/20 transition-colors">
                                <td class="p-4 pl-6 font-mono text-xs text-muted-foreground">SKU-89204-EP</td>
                                <td class="p-4 font-semibold text-foreground">Caja de Cartón Reforzada (Grande)</td>
                                <td class="p-4">Empaquetado</td>
                                <td class="p-4 font-bold text-foreground">0 pzas</td>
                                <td class="p-4 font-bold text-foreground">$3.50</td>
                                <td class="p-4 pr-6 text-right">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/10">
                                        Agotado
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</AppLayout>
