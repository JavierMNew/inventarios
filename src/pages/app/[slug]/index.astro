---
import AppLayout from "../../../layouts/AppLayout.astro";
import { supabase } from "../../../lib/supabase";
import PageHeader from "@/components/page-header.astro";
import { buttonVariants } from "@/components/ui/button";
import { 
    LayoutDashboard, 
    Building2, 
    Users, 
    Package, 
    Receipt, 
    Coins, 
    TrendingUp, 
    AlertTriangle, 
    Activity,
    Bell,
    Plus,
    DollarSign,
    UserPlus,
    CheckCircle2
} from "lucide-react";
export const prerender = false;

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

await supabase.auth.setSession({
    refresh_token: refreshToken!.value,
    access_token: accessToken!.value,
});

const {
    data: { user },
} = await supabase.auth.getUser();
const metadata = user?.user_metadata;

const { data: empresas } = await supabase
    .from("empresas")
    .select("id, nombre, slug");

const currentEmpresa = empresas?.find((e) => e.slug === Astro.params.slug);

if (!currentEmpresa) {
    return Astro.redirect("/dashboard");
}

// Consultar miembros reales para obtener la cifra exacta
const { data: miembros } = await supabase
    .from("miembros_empresa")
    .select("user_id")
    .eq("empresa_id", currentEmpresa.id);

const totalMiembros = miembros?.length || 5; // Fallback realista

// Datos simulados premium para las analíticas internas de la empresa
const statsData = {
    miembros: totalMiembros,
    productos: 348,
    inventarioValor: 48500,
    gastosMes: 14250,
    gastosLimite: 20000
};
---

<AppLayout
    title={`Inicio - ${currentEmpresa?.nombre}`}
    slug={currentEmpresa?.slug ?? ""}
    companyName={currentEmpresa?.nombre ?? ""}
    currentPage="Inicio"
    empresas={empresas ?? []}
    userName={`${metadata?.first_name ?? ""} ${metadata?.last_name ?? ""}`.trim() || user?.email?.split("@")[0] || "Usuario"}
    userEmail={user?.email ?? ""}
>
    <div class="space-y-6 w-full py-2">
        {/* Cabecera Premium Reutilizable */}
        <PageHeader 
            title="Inicio" 
            description={`Panel principal y resumen analítico operacional de ${currentEmpresa?.nombre}.`}
        >
            <LayoutDashboard slot="icon" className="size-5" />
            
            <a 
                href={`/app/${currentEmpresa?.slug}/settings`} 
                class={`${buttonVariants({ variant: "outline" })} shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 font-semibold gap-2 cursor-pointer`}
                slot="actions"
            >
                <Building2 className="size-4" />
                Ajustes de Empresa
            </a>
        </PageHeader>

        {/* Resumen de Categorías Clave (Top Metrics) */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {/* Tarjeta 1: Inventario */}
            <a 
                href={`/app/${currentEmpresa?.slug}/inventory`}
                class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs flex flex-col justify-between hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group"
            >
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-muted-foreground uppercase tracking-wider">Inventario</span>
                    <div class="p-2 bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-lg border border-blue-500/20 group-hover:scale-105 transition-transform duration-300">
                        <Package className="size-4.5" />
                    </div>
                </div>
                <div class="mt-4 space-y-2">
                    <div class="flex items-baseline gap-2">
                        <h3 class="text-3xl font-extrabold tracking-tight text-foreground">{statsData.productos}</h3>
                        <span class="text-xs text-muted-foreground font-semibold">Artículos</span>
                    </div>
                    <div class="space-y-1">
                        <div class="flex justify-between text-[11px] text-muted-foreground font-semibold">
                            <span>Valor total estimado</span>
                            <span class="text-foreground">${statsData.inventarioValor.toLocaleString()} USD</span>
                        </div>
                        <div class="w-full h-1.5 bg-muted rounded-full overflow-hidden">
                            <div class="h-full bg-blue-500 rounded-full" style="width: 72%"></div>
                        </div>
                    </div>
                </div>
            </a>

            {/* Tarjeta 2: Gastos */}
            <a 
                href={`/app/${currentEmpresa?.slug}/expenses`}
                class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs flex flex-col justify-between hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group"
            >
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-muted-foreground uppercase tracking-wider">Gastos Mensuales</span>
                    <div class="p-2 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded-lg border border-emerald-500/20 group-hover:scale-105 transition-transform duration-300">
                        <Coins className="size-4.5" />
                    </div>
                </div>
                <div class="mt-4 space-y-2">
                    <div class="flex items-baseline gap-2">
                        <h3 class="text-3xl font-extrabold tracking-tight text-foreground">${statsData.gastosMes.toLocaleString()}</h3>
                        <span class="text-xs text-muted-foreground font-semibold">/ ${statsData.gastosLimite.toLocaleString()}</span>
                    </div>
                    <div class="space-y-1">
                        <div class="flex justify-between text-[11px] text-muted-foreground font-semibold">
                            <span>Consumo de presupuesto</span>
                            <span class="text-emerald-500 font-bold">71.2%</span>
                        </div>
                        <div class="w-full h-1.5 bg-muted rounded-full overflow-hidden">
                            <div class="h-full bg-emerald-500 rounded-full" style="width: 71.2%"></div>
                        </div>
                    </div>
                </div>
            </a>

            {/* Tarjeta 3: Colaboradores */}
            <a 
                href={`/app/${currentEmpresa?.slug}/members`}
                class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs flex flex-col justify-between hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group"
            >
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-muted-foreground uppercase tracking-wider">Miembros</span>
                    <div class="p-2 bg-violet-500/10 text-violet-600 dark:text-violet-400 rounded-lg border border-violet-500/20 group-hover:scale-105 transition-transform duration-300">
                        <Users className="size-4.5" />
                    </div>
                </div>
                <div class="mt-4 space-y-2">
                    <div class="flex items-baseline gap-2">
                        <h3 class="text-3xl font-extrabold tracking-tight text-foreground">{statsData.miembros}</h3>
                        <span class="text-xs text-muted-foreground font-semibold">Activos</span>
                    </div>
                    <div class="flex items-center gap-1.5 pt-1.5">
                        <div class="flex -space-x-2">
                            <div class="size-6 rounded-full bg-violet-500 text-[10px] font-bold text-white flex items-center justify-center border border-background">JM</div>
                            <div class="size-6 rounded-full bg-blue-500 text-[10px] font-bold text-white flex items-center justify-center border border-background">SC</div>
                            <div class="size-6 rounded-full bg-emerald-500 text-[10px] font-bold text-white flex items-center justify-center border border-background">AL</div>
                            {statsData.miembros > 3 && (
                                <div class="size-6 rounded-full bg-muted text-[10px] font-bold text-muted-foreground flex items-center justify-center border border-background">
                                    +{statsData.miembros - 3}
                                </div>
                            )}
                        </div>
                        <span class="text-[11px] text-muted-foreground font-medium pl-1">Gestiona accesos y roles</span>
                    </div>
                </div>
            </a>
        </div>

        {/* Sección de Analíticas y Gráficas Reales */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {/* Gráfica de Gastos Mensuales (Smooth SVG Area Chart) */}
            <div class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs space-y-4">
                <div class="flex items-center justify-between border-b border-border/50 pb-3">
                    <div class="space-y-0.5">
                        <h3 class="text-lg font-bold text-foreground flex items-center gap-1.5">
                            <Activity className="size-4 text-emerald-500 animate-pulse" />
                            Historial de Egresos
                        </h3>
                        <p class="text-xs text-muted-foreground">Gastos en los últimos 6 meses (USD)</p>
                    </div>
                    <span class="text-xs font-bold text-emerald-500 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full flex items-center gap-1">
                        <TrendingUp className="size-3" />
                        Estable
                    </span>
                </div>

                {/* SVG Area Chart */}
                <div class="relative w-full h-56 pt-2">
                    <svg viewBox="0 0 500 200" class="w-full h-full overflow-visible" preserveAspectRatio="none">
                        <defs>
                            <linearGradient id="areaGradient" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="var(--color-primary, #10b981)" stop-opacity="0.3"/>
                                <stop offset="100%" stop-color="var(--color-primary, #10b981)" stop-opacity="0.0"/>
                            </linearGradient>
                        </defs>
                        {/* Gridlines */}
                        <line x1="0" y1="160" x2="500" y2="160" stroke="var(--border, rgba(255,255,255,0.05))" stroke-dasharray="4" stroke-width="1.5" />
                        <line x1="0" y1="100" x2="500" y2="100" stroke="var(--border, rgba(255,255,255,0.05))" stroke-dasharray="4" stroke-width="1.5" />
                        <line x1="0" y1="40" x2="500" y2="40" stroke="var(--border, rgba(255,255,255,0.05))" stroke-dasharray="4" stroke-width="1.5" />

                        {/* Área de la gráfica */}
                        <path d="M 0 160 C 50 140, 100 150, 150 110 C 200 70, 250 85, 300 45 C 350 5, 400 90, 450 60 L 500 75 L 500 180 L 0 180 Z" fill="url(#areaGradient)" />

                        {/* Línea del gráfico */}
                        <path d="M 0 160 C 50 140, 100 150, 150 110 C 200 70, 250 85, 300 45 C 350 5, 400 90, 450 60 L 500 75" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" />

                        {/* Puntos destacados */}
                        <circle cx="300" cy="45" r="5" fill="#10b981" stroke="#ffffff" stroke-width="1.5" />
                        <circle cx="500" cy="75" r="5" fill="#10b981" stroke="#ffffff" stroke-width="1.5" />
                    </svg>

                    {/* Eje X (Etiquetas) */}
                    <div class="flex justify-between text-[10px] text-muted-foreground font-semibold pt-2 px-1 border-t border-border/40">
                        <span>Ene</span>
                        <span>Feb</span>
                        <span>Mar</span>
                        <span>Abr</span>
                        <span>May</span>
                        <span>Jun (Act)</span>
                    </div>
                </div>
            </div>

            {/* Distribución por Categorías y Alertas (Inventory breakdown) */}
            <div class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs space-y-4">
                <div class="flex items-center justify-between border-b border-border/50 pb-3">
                    <div class="space-y-0.5">
                        <h3 class="text-lg font-bold text-foreground flex items-center gap-1.5">
                            <Package className="size-4 text-blue-500" />
                            Distribución de Almacén
                        </h3>
                        <p class="text-xs text-muted-foreground">Categorización y porcentaje físico</p>
                    </div>
                    <span class="text-xs font-semibold text-muted-foreground">3 Categorías</span>
                </div>

                <div class="space-y-4 pt-1">
                    {/* Fila 1 */}
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-semibold">
                            <span class="text-foreground">Materia Prima (Madera, Acero, etc.)</span>
                            <span class="text-muted-foreground">220 artículos (63%)</span>
                        </div>
                        <div class="w-full h-2.5 bg-muted rounded-full overflow-hidden">
                            <div class="h-full bg-blue-500 rounded-full" style="width: 63%"></div>
                        </div>
                    </div>

                    {/* Fila 2 */}
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-semibold">
                            <span class="text-foreground">Producto Terminado (Sillas, Mesas)</span>
                            <span class="text-muted-foreground">112 artículos (32%)</span>
                        </div>
                        <div class="w-full h-2.5 bg-muted rounded-full overflow-hidden">
                            <div class="h-full bg-violet-500 rounded-full" style="width: 32%"></div>
                        </div>
                    </div>

                    {/* Fila 3 */}
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-xs font-semibold">
                            <span class="text-foreground">Empaquetado (Cajas, Plásticos)</span>
                            <span class="text-muted-foreground">16 artículos (5%)</span>
                        </div>
                        <div class="w-full h-2.5 bg-muted rounded-full overflow-hidden">
                            <div class="h-full bg-amber-500 rounded-full" style="width: 5%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {/* Sección de Notificaciones y Alertas Críticas (Reemplaza a Accesos Directos) */}
        <div class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-border/50 pb-3">
                <div class="space-y-0.5 flex items-center gap-2">
                    <div class="p-1.5 bg-primary/10 text-primary rounded-lg border border-primary/20">
                        <Bell className="size-4.5" />
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-foreground">Alertas y Actividad Reciente</h3>
                        <p class="text-xs text-muted-foreground">Sucesos operativos críticos de la empresa</p>
                    </div>
                </div>
                <span class="text-xs font-bold text-amber-500 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded-full">
                    2 Pendientes
                </span>
            </div>

            <div class="divide-y divide-border/40">
                {/* Alerta 1 */}
                <div class="py-3.5 flex items-start justify-between gap-4 group">
                    <div class="flex items-start gap-3">
                        <div class="p-2 bg-amber-500/10 text-amber-600 dark:text-amber-400 rounded-xl border border-amber-500/20 mt-0.5 shrink-0">
                            <AlertTriangle className="size-4" />
                        </div>
                        <div class="space-y-0.5">
                            <h4 class="text-sm font-bold text-foreground flex items-center gap-1.5">
                                Stock Bajo de Producto
                            </h4>
                            <p class="text-xs text-muted-foreground">
                                El artículo <strong class="text-foreground">Silla Comedor Escandinava</strong> tiene sólo 8 unidades restantes en el almacén de producto terminado.
                            </p>
                        </div>
                    </div>
                    <div class="text-right shrink-0">
                        <span class="text-[10px] font-mono text-muted-foreground block">Hace 15 min</span>
                        <a href={`/app/${currentEmpresa?.slug}/inventory`} class="text-[11px] font-bold text-primary hover:underline">Reabastecer</a>
                    </div>
                </div>

                {/* Alerta 2 */}
                <div class="py-3.5 flex items-start justify-between gap-4 group">
                    <div class="flex items-start gap-3">
                        <div class="p-2 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded-xl border border-emerald-500/20 mt-0.5 shrink-0">
                            <CheckCircle2 className="size-4" />
                        </div>
                        <div class="space-y-0.5">
                            <h4 class="text-sm font-bold text-foreground flex items-center gap-1.5">
                                Compra Registrada Exitosamente
                            </h4>
                            <p class="text-xs text-muted-foreground">
                                Se registró el egreso de <strong class="text-foreground">Compra de materia prima A</strong> por un monto de <strong class="text-foreground">$4,500.00 USD</strong>.
                            </p>
                        </div>
                    </div>
                    <div class="text-right shrink-0">
                        <span class="text-[10px] font-mono text-muted-foreground block">Hace 2 horas</span>
                        <a href={`/app/${currentEmpresa?.slug}/expenses`} class="text-[11px] font-bold text-primary hover:underline">Ver Recibo</a>
                    </div>
                </div>

                {/* Alerta 3 */}
                <div class="py-3.5 flex items-start justify-between gap-4 group">
                    <div class="flex items-start gap-3">
                        <div class="p-2 bg-violet-500/10 text-violet-600 dark:text-violet-400 rounded-xl border border-violet-500/20 mt-0.5 shrink-0">
                            <UserPlus className="size-4" />
                        </div>
                        <div class="space-y-0.5">
                            <h4 class="text-sm font-bold text-foreground flex items-center gap-1.5">
                                Nuevo Miembro Colaborador
                            </h4>
                            <p class="text-xs text-muted-foreground">
                                Un nuevo usuario fue invitado y asignado con el rol de <strong class="text-foreground">Contador</strong> dentro del espacio de trabajo.
                            </p>
                        </div>
                    </div>
                    <div class="text-right shrink-0">
                        <span class="text-[10px] font-mono text-muted-foreground block">Ayer</span>
                        <a href={`/app/${currentEmpresa?.slug}/members`} class="text-[11px] font-bold text-primary hover:underline">Gestionar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</AppLayout>
