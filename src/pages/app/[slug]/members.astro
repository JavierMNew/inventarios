---
import { EmptyMembers } from "@/components/no-projects";
import AppLayout from "../../../layouts/AppLayout.astro";
import { supabase } from "../../../lib/supabase";
import { buttonVariants } from "@/components/ui/button";
import { MembersList } from "@/components/members-list";
import PageHeader from "@/components/page-header.astro";
import { Plus, Users } from "lucide-react";
export const prerender = false;

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

await supabase.auth.setSession({
    refresh_token: refreshToken!.value,
    access_token: accessToken!.value,
});

const {
    data: { user },
} = await supabase.auth.getUser();
const metadata = user?.user_metadata;

const { data: empresas } = await supabase
    .from("empresas")
    .select("id, nombre, slug");

const currentEmpresa = empresas?.find((e) => e.slug === Astro.params.slug);

if (!currentEmpresa) {
    return Astro.redirect("/app");
}

const { data: miembros, error: fetchMembersError } = await supabase
    .from("miembros_empresa")
    .select(
        `
        user_id,
        rol,
        empresa_id,
        profiles ( first_name, last_name, email )
    `,
    )
    .eq("empresa_id", currentEmpresa.id);

if (fetchMembersError) {
    console.error("Error fetching members:", fetchMembersError);
}

// Verificar si el usuario actual tiene permisos de administración
const currentUserMember = miembros?.find((m) => m.user_id === user?.id);
const isAdminOrOwner = currentUserMember ? ['owner', 'admin'].includes(currentUserMember.rol) : false;
---

<AppLayout
    title={`Miembros - ${currentEmpresa?.nombre}`}
    slug={currentEmpresa?.slug ?? ""}
    companyName={currentEmpresa?.nombre ?? ""}
    currentPage="Miembros"
    empresas={empresas ?? []}
    userName={`${metadata?.first_name ?? ""} ${metadata?.last_name ?? ""}`.trim() ||
        user?.email?.split("@")[0] ||
        "Usuario"}
    userEmail={user?.email ?? ""}
>
    <div class="space-y-6 w-full py-2">
        {/* Cabecera Premium */}
        <PageHeader 
            title="Miembros" 
            description={`Administra y gestiona los roles y accesos del equipo de ${currentEmpresa?.nombre}`}
        >
            <Users slot="icon" className="size-5" />
            
            {isAdminOrOwner && (
                <a 
                    href="/create-member" 
                    class={`${buttonVariants()} shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 group font-semibold`}
                    slot="actions"
                >
                    <Plus className="size-4 transition-transform duration-300 group-hover:rotate-90" />
                    Agregar miembro
                </a>
            )}
        </PageHeader>

        {/* Listado Interactivo */}
        {
            miembros && miembros.length > 0 ? (
                <MembersList 
                    client:load 
                    initialMembers={miembros as any} 
                    currentUserId={user?.id ?? ""}
                    companyId={currentEmpresa.id}
                    isAdminOrOwner={isAdminOrOwner}
                />
            ) : (
                <div class="flex flex-col items-center justify-center p-8 border border-dashed rounded-xl bg-card/40 backdrop-blur-md">
                    <EmptyMembers />
                </div>
            )
        }
    </div>
</AppLayout>
