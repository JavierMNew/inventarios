---
import AppLayout from "../../../layouts/AppLayout.astro";
import { supabase } from "../../../lib/supabase";
import PageHeader from "@/components/page-header.astro";
import { buttonVariants } from "@/components/ui/button";
import { Settings2, Save, Building2, Globe, Trash2, ShieldAlert } from "lucide-react";
export const prerender = false;

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

await supabase.auth.setSession({
    refresh_token: refreshToken!.value,
    access_token: accessToken!.value,
});

const {
    data: { user },
} = await supabase.auth.getUser();
const metadata = user?.user_metadata;

const { data: empresas } = await supabase
    .from("empresas")
    .select("nombre, slug");

const currentEmpresa = empresas?.find((e) => e.slug === Astro.params.slug);
---

<AppLayout
    title={`Configuración - ${currentEmpresa?.nombre}`}
    slug={currentEmpresa?.slug ?? ""}
    companyName={currentEmpresa?.nombre ?? ""}
    currentPage="Configuración"
    empresas={empresas ?? []}
    userName={`${metadata?.first_name ?? ""} ${metadata?.last_name ?? ""}`.trim() || user?.email?.split("@")[0] || "Usuario"}
    userEmail={user?.email ?? ""}
>
    <div class="space-y-6 w-full py-2">
        {/* Cabecera Premium Reutilizable */}
        <PageHeader 
            title="Configuración" 
            description={`Gestiona los parámetros globales, información general y preferencias del sistema para ${currentEmpresa?.nombre}.`}
        >
            <Settings2 slot="icon" className="size-5" />
            
            <button 
                type="submit"
                form="settings-form"
                class={`${buttonVariants()} shadow-sm hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 group font-semibold cursor-pointer`}
                slot="actions"
            >
                <Save className="size-4" />
                Guardar cambios
            </button>
        </PageHeader>

        {/* Formulario Estructurado Premium */}
        <form id="settings-form" class="space-y-6 max-w-4xl">
            {/* Sección 1: Información de la Empresa */}
            <div class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs space-y-4">
                <div class="flex items-center gap-2 pb-2 border-b border-border/50">
                    <Building2 className="size-5 text-primary" />
                    <h3 class="text-lg font-bold text-foreground">Perfil de la Empresa</h3>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label for="company-name" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                            Nombre Comercial
                        </label>
                        <input 
                            type="text" 
                            id="company-name" 
                            value={currentEmpresa?.nombre}
                            class="w-full px-3.5 py-2 border border-border bg-card/35 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-medium"
                        />
                    </div>

                    <div class="space-y-1.5">
                        <label for="company-slug" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                            Identificador / Slug URL
                        </label>
                        <input 
                            type="text" 
                            id="company-slug" 
                            value={currentEmpresa?.slug}
                            disabled
                            class="w-full px-3.5 py-2 border border-border bg-card/10 text-muted-foreground rounded-xl text-sm focus:outline-none cursor-not-allowed font-mono"
                        />
                    </div>
                </div>
            </div>

            {/* Sección 2: Preferencias y Región */}
            <div class="p-6 border border-border/80 rounded-2xl bg-card/40 backdrop-blur-md shadow-xs space-y-4">
                <div class="flex items-center gap-2 pb-2 border-b border-border/50">
                    <Globe className="size-5 text-primary" />
                    <h3 class="text-lg font-bold text-foreground">Ajustes Regionales</h3>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label for="currency" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                            Moneda de Cuenta
                        </label>
                        <select 
                            id="currency" 
                            class="w-full px-3.5 py-2 border border-border bg-card/35 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-medium"
                        >
                            <option value="MXN">Peso Mexicano (MXN)</option>
                            <option value="USD">Dólar Americano (USD)</option>
                            <option value="EUR">Euro (EUR)</option>
                        </select>
                    </div>

                    <div class="space-y-1.5">
                        <label for="timezone" class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                            Zona Horaria
                        </label>
                        <select 
                            id="timezone" 
                            class="w-full px-3.5 py-2 border border-border bg-card/35 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-medium"
                        >
                            <option value="America/Mexico_City">Ciudad de México (GMT-6)</option>
                            <option value="America/New_York">Nueva York (GMT-5)</option>
                            <option value="Europe/Madrid">Madrid (GMT+1)</option>
                        </select>
                    </div>
                </div>
            </div>

            {/* Sección 3: Zona de Peligro */}
            <div class="p-6 border border-destructive/20 rounded-2xl bg-destructive/5 backdrop-blur-md shadow-xs space-y-4">
                <div class="flex items-center gap-2 pb-2 border-b border-destructive/10">
                    <ShieldAlert className="size-5 text-destructive" />
                    <h3 class="text-lg font-bold text-destructive">Zona de Peligro</h3>
                </div>
                
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div class="space-y-1">
                        <p class="text-sm font-bold text-foreground">Eliminar definitivamente esta empresa</p>
                        <p class="text-xs text-muted-foreground max-w-lg">
                            Esta acción borrará de manera irreversible el inventario, egresos, registros de transacciones y accesos de los miembros. No hay marcha atrás.
                        </p>
                    </div>
                    <button 
                        type="button" 
                        class={`${buttonVariants({ variant: "destructive" })} shadow-xs hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 font-semibold cursor-pointer`}
                    >
                        <Trash2 className="size-4" />
                        Eliminar Empresa
                    </button>
                </div>
            </div>
        </form>
    </div>
</AppLayout>
