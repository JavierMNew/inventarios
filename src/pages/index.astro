---
import Layout from "../layouts/Layout.astro";
---

<Layout title="SERDISUR - Plataforma Inteligente de Inventarios" description="Controla el inventario de tus empresas con precisión quirúrgica, roles colaborativos y seguridad en tiempo real.">
  <main class="relative overflow-hidden bg-background">
    <!-- Fondo decorativo con rejilla y gradiente -->
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
    <div class="absolute inset-y-0 right-0 -z-10 w-[600px] bg-gradient-to-l from-violet-500/10 to-fuchsia-500/5 blur-3xl [mask-image:radial-gradient(ellipse_at_center,transparent_20%,#000_100%)]"></div>

    <!-- HERO SECTION -->
    <section class="container mx-auto max-w-7xl px-4 pt-20 pb-16 sm:px-6 sm:pt-24 lg:px-8 lg:pt-32">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-8 items-center">
        <!-- Text Column -->
        <div class="lg:col-span-6 flex flex-col items-center text-center lg:items-start lg:text-left gap-6 animate-fade-in-up">
          <div class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
            <span class="h-1.5 w-1.5 rounded-full bg-primary animate-pulse"></span>
            Nuevo: Control multi-empresa activo
          </div>
          
          <h1 class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-6xl leading-[1.1] text-balance">
            Controla tu inventario con <span class="bg-gradient-to-r from-violet-600 to-indigo-600 bg-clip-text text-transparent">precisión absoluta</span>
          </h1>
          
          <p class="text-lg text-muted-foreground leading-relaxed max-w-lg text-pretty">
            La plataforma moderna de gestión de stock y administración colaborativa diseñada para impulsar a las empresas del sureste. Rápida, intuitiva y 100% segura.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mt-2">
            <a 
              href="/register" 
              class="w-full sm:w-auto inline-flex h-11 items-center justify-center rounded-lg bg-primary px-8 text-sm font-semibold text-primary-foreground shadow-lg transition-all hover:bg-primary/90 hover:shadow-xl active:scale-98"
            >
              Comenzar gratis
            </a>
            <a 
              href="/signin" 
              class="w-full sm:w-auto inline-flex h-11 items-center justify-center rounded-lg border border-border bg-background px-8 text-sm font-semibold text-foreground transition-all hover:bg-accent hover:text-accent-foreground active:scale-98"
            >
              Iniciar sesión
            </a>
          </div>

          <div class="flex items-center gap-6 mt-4 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Sin tarjeta de crédito
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              Cifrado SSL/TLS SSL Activo
            </div>
          </div>
        </div>

        <!-- Visual Column (Mock Dashboard) -->
        <div class="lg:col-span-6 animate-fade-in">
          <div class="relative rounded-2xl border border-border/60 bg-card/65 p-4 shadow-2xl backdrop-blur-xl transition-all duration-500 hover:scale-[1.01] hover:shadow-violet-500/5">
            <!-- Decorative colored glows -->
            <div class="absolute -top-10 -left-10 -z-10 h-40 w-40 rounded-full bg-violet-500/10 blur-2xl"></div>
            <div class="absolute -bottom-10 -right-10 -z-10 h-40 w-40 rounded-full bg-indigo-500/10 blur-2xl"></div>

            <!-- Window Header -->
            <div class="flex items-center justify-between border-b border-border/40 pb-3 mb-4">
              <div class="flex items-center gap-1.5">
                <span class="h-3 w-3 rounded-full bg-rose-500/80"></span>
                <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
                <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
              </div>
              <div class="rounded-md bg-muted px-4 py-0.5 text-3xs font-mono text-muted-foreground">
                https://serdisur.com/dashboard
              </div>
              <div class="w-8"></div>
            </div>

            <!-- Mock App Body Layout -->
            <div class="grid grid-cols-12 gap-3 min-h-[300px]">
              <!-- Mock Sidebar -->
              <div class="col-span-3 border-r border-border/20 pr-2 hidden sm:flex flex-col gap-2">
                <div class="h-7 rounded bg-primary/10 flex items-center px-2 text-[10px] font-bold text-primary">
                  📦 SERDISUR
                </div>
                <div class="h-5 rounded bg-muted/60"></div>
                <div class="h-5 rounded bg-muted/60"></div>
                <div class="h-5 rounded bg-muted/60"></div>
                <div class="mt-auto h-5 rounded bg-muted/40"></div>
              </div>

              <!-- Mock Content Area -->
              <div class="col-span-12 sm:col-span-9 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                  <div class="h-4 w-28 rounded bg-muted"></div>
                  <div class="h-6 w-16 rounded bg-primary/95"></div>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <div class="rounded-lg border border-border/40 p-2.5 flex flex-col gap-1 bg-background/50">
                    <span class="text-[9px] text-muted-foreground uppercase font-semibold">Productos</span>
                    <span class="text-sm font-bold">142</span>
                  </div>
                  <div class="rounded-lg border border-border/40 p-2.5 flex flex-col gap-1 bg-background/50">
                    <span class="text-[9px] text-muted-foreground uppercase font-semibold">Bajo Stock</span>
                    <span class="text-sm font-bold text-amber-600">3</span>
                  </div>
                  <div class="rounded-lg border border-border/40 p-2.5 flex flex-col gap-1 bg-background/50">
                    <span class="text-[9px] text-muted-foreground uppercase font-semibold">Miembros</span>
                    <span class="text-sm font-bold">5</span>
                  </div>
                </div>

                <!-- Table Mock -->
                <div class="rounded-lg border border-border/40 bg-background/40 overflow-hidden flex flex-col text-2xs">
                  <div class="grid grid-cols-12 gap-1 border-b border-border/20 bg-muted/40 p-2 font-semibold text-muted-foreground">
                    <div class="col-span-5">Producto</div>
                    <div class="col-span-4">Stock</div>
                    <div class="col-span-3 text-right">Estado</div>
                  </div>
                  <div class="flex flex-col">
                    <div class="grid grid-cols-12 gap-1 border-b border-border/10 p-2 items-center hover:bg-muted/10">
                      <div class="col-span-5 font-medium">iPhone 15 Pro</div>
                      <div class="col-span-4">42 unidades</div>
                      <div class="col-span-3 text-right">
                        <span class="rounded-full bg-emerald-500/10 px-1.5 py-0.5 text-[9px] font-medium text-emerald-600 border border-emerald-500/10">Stock</span>
                      </div>
                    </div>
                    <div class="grid grid-cols-12 gap-1 border-b border-border/10 p-2 items-center hover:bg-muted/10">
                      <div class="col-span-5 font-medium">MacBook M3</div>
                      <div class="col-span-4">2 unidades</div>
                      <div class="col-span-3 text-right">
                        <span class="rounded-full bg-amber-500/10 px-1.5 py-0.5 text-[9px] font-medium text-amber-600 border border-amber-500/10">Crítico</span>
                      </div>
                    </div>
                    <div class="grid grid-cols-12 gap-1 p-2 items-center hover:bg-muted/10">
                      <div class="col-span-5 font-medium">iPad Air</div>
                      <div class="col-span-4">18 unidades</div>
                      <div class="col-span-3 text-right">
                        <span class="rounded-full bg-emerald-500/10 px-1.5 py-0.5 text-[9px] font-medium text-emerald-600 border border-emerald-500/10">Stock</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- METRICS STRIP -->
    <section class="border-y border-border/40 bg-muted/20 py-8">
      <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-6 md:grid-cols-4 text-center">
          <div class="flex flex-col gap-1">
            <span class="text-3xl font-extrabold text-foreground">99.9%</span>
            <span class="text-xs text-muted-foreground uppercase font-semibold tracking-wider">Precisión de inventario</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-3xl font-extrabold text-foreground">100%</span>
            <span class="text-xs text-muted-foreground uppercase font-semibold tracking-wider">Cumplimiento SSL/TLS</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-3xl font-extrabold text-foreground">1 click</span>
            <span class="text-xs text-muted-foreground uppercase font-semibold tracking-wider">Cambio entre empresas</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-3xl font-extrabold text-foreground">24/7</span>
            <span class="text-xs text-muted-foreground uppercase font-semibold tracking-wider">Acceso seguro desde la nube</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES SECTION -->
    <section id="features" class="container mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 flex flex-col gap-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-primary">Diseñado para el Crecimiento</h2>
        <p class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
          Características premium para optimizar tu operación diaria
        </p>
        <p class="text-base text-muted-foreground">
          Dejamos atrás las complejas hojas de cálculo para ofrecerte una interfaz moderna, colaborativa y protegida.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- Feature 1 -->
        <div class="group relative rounded-xl border border-border/40 bg-card p-6 shadow-sm transition-all duration-300 hover:scale-[1.02] hover:shadow-md">
          <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary transition-transform group-hover:scale-110">
            <!-- Icon Multi-empresa -->
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">Control Multi-empresa</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Administra diferentes sucursales, razones sociales o proyectos de forma independiente desde una única sesión de usuario.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="group relative rounded-xl border border-border/40 bg-card p-6 shadow-sm transition-all duration-300 hover:scale-[1.02] hover:shadow-md">
          <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary transition-transform group-hover:scale-110">
            <!-- Icon Colaboradores -->
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 005.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">Roles & Permisos de Equipo</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Asigna roles como Propietario, Administrador, Contador o Ayudante para garantizar que cada colaborador tenga acceso solo a lo que le corresponde.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="group relative rounded-xl border border-border/40 bg-card p-6 shadow-sm transition-all duration-300 hover:scale-[1.02] hover:shadow-md">
          <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary transition-transform group-hover:scale-110">
            <!-- Icon TLS SSL -->
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-foreground mb-2">Seguridad SSL/TLS Habilitada</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Cifrado completo de extremo a extremo a través de HTTPS. Protegemos tus datos contra ataques MITM y CSRF con cookies seguras y seguridades avanzadas.
          </p>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="border-t border-border/40 bg-muted/10 py-20">
      <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16 flex flex-col gap-4">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-primary">Flujo de Trabajo</h2>
          <p class="text-3xl font-extrabold tracking-tight text-foreground">
            Listo para usar en tres simples pasos
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          <!-- Step 1 -->
          <div class="flex flex-col items-center text-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary text-primary-foreground font-bold text-lg shadow-md">
              1
            </div>
            <h3 class="text-lg font-bold text-foreground">Regístrate en la plataforma</h3>
            <p class="text-xs text-muted-foreground leading-relaxed max-w-xs">
              Crea tu perfil personal de usuario utilizando tu correo electrónico de forma segura.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="flex flex-col items-center text-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary text-primary-foreground font-bold text-lg shadow-md">
              2
            </div>
            <h3 class="text-lg font-bold text-foreground">Registra tu Empresa</h3>
            <p class="text-xs text-muted-foreground leading-relaxed max-w-xs">
              Configura los detalles básicos de tu negocio, colores visuales, teléfonos y equipo de trabajo.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="flex flex-col items-center text-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary text-primary-foreground font-bold text-lg shadow-md">
              3
            </div>
            <h3 class="text-lg font-bold text-foreground">Gestiona tus productos</h3>
            <p class="text-xs text-muted-foreground leading-relaxed max-w-xs">
              Da de alta stock, controla entradas/salidas y supervisa los movimientos de tu equipo en tiempo real.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECURITY CARD SECTION -->
    <section id="security" class="container mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-2xl border border-border/40 bg-card p-8 md:p-12 shadow-xl flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <div class="absolute inset-0 -z-10 bg-gradient-to-br from-violet-500/5 to-indigo-500/5"></div>
        
        <div class="flex-shrink-0 h-16 w-16 md:h-24 md:w-24 flex items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-500">
          <svg class="h-10 w-10 md:h-14 md:w-14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>

        <div class="flex flex-col gap-3 max-w-xl text-center md:text-left">
          <span class="inline-flex self-center md:self-start items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-600 border border-emerald-500/10">
            Tecnología TLS 1.3 Certificada
          </span>
          <h3 class="text-2xl font-bold text-foreground">Seguridad en cada transacción</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            La plataforma implementa controles criptográficos de primer nivel. Toda la comunicación entre tu navegador, Vercel y la base de datos de Supabase está cifrada con SSL/TLS. Las sesiones de usuario utilizan cookies blindadas con propiedades <code class="font-mono text-xs px-1 py-0.5 rounded bg-muted">HttpOnly</code>, <code class="font-mono text-xs px-1 py-0.5 rounded bg-muted">Secure</code> y <code class="font-mono text-xs px-1 py-0.5 rounded bg-muted">SameSite=Lax</code> para neutralizar ataques de secuestro de sesión y suplantación de identidad.
          </p>
        </div>
      </div>
    </section>

    <!-- CALL TO ACTION (CTA) -->
    <section class="container mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-2xl bg-primary text-primary-foreground p-8 md:p-16 text-center shadow-2xl flex flex-col items-center gap-6">
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-violet-600 to-indigo-700"></div>
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_center,transparent_20%,#000_100%)] opacity-30"></div>
        
        <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl max-w-2xl text-balance">
          Lleva el control de tu negocio al siguiente nivel hoy mismo
        </h2>
        
        <p class="text-primary-foreground/80 max-w-md text-sm md:text-base text-pretty">
          Empieza a gestionar tu stock de forma colaborativa con total seguridad y visibilidad.
        </p>

        <a 
          href="/register" 
          class="inline-flex h-11 items-center justify-center rounded-lg bg-background px-8 text-sm font-semibold text-foreground shadow-md transition-all hover:bg-background/90 hover:scale-102 active:scale-98"
        >
          Crear cuenta gratis
        </a>
      </div>
    </section>
  </main>
</Layout>
